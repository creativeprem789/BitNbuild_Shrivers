# Environment
ENVIRONMENT=development
DEBUG=true

# Database:
# - Local / Hackathon Demo: persists on disk in task_harness.db with zero extra setup
DATABASE_URL=sqlite+aiosqlite:///task_harness.db
# - Cloud Deployment (Neon / Supabase / Render Postgres / Railway):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_harness

# Redis (Optional; leave empty for instant In-Memory Event Bus)
REDIS_URL=

# Google Gemini API (gemini-2.5-flash for classification & agent reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
ROUTER_MODEL=gemini-2.5-flash
AGENT_MODEL=gemini-2.5-flash

# External Calendar Integration (Sandbox / Provider)
CALENDAR_API_BASE_URL=https://api.calendardemo.local/v1
CALENDAR_API_KEY=calendar_sandbox_token_abc123

# Server & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]
